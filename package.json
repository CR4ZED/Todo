{
  "name": "todo-app",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db": "docker compose up -d",
    "dev": "npm run db && concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "seed": "npm run seed -w backend",
    "test": "npm test -w backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
